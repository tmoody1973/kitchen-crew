      "name": "Stamps",
      "kind": "chip",
      "refersTo": "stamp-under",
      "description": "Verdicts. Under = kale ink, over = squash ink, ink and tagged for non-budget statuses.",
      "html": "<div class=\"ds-row\"><span class=\"ds-stamp ds-under\">Fits your budget</span><span class=\"ds-stamp ds-over\">Over by $4</span><span class=\"ds-stamp ds-ink\">Have</span><span class=\"ds-stamp ds-tagged\">Out</span></div>",
      "css": ":root{--color-ground:#fbf8f1;--color-ink:#1d241f;--color-ink-soft:#5b5346;--color-crate:#6b4f2e;--color-slate:#1f2a24;--color-slate-cell:#3a4a41;--color-chalk:#f4f1e8;--color-chalk-dim:#b9c4bc;--color-tag:#ffd23f;--color-tomato:#d33722;--color-tomato-dark:#a82b1b;--color-line:#e9e1d2;--color-kale:#2e8b3e;--color-kale-ink:#1f6b2c;--color-kale-wash:#eef7ea;--color-squash:#f26b1d;--color-squash-ink:#a8430c;--color-squash-wash:#fff1e6;--font-sign:'Bowlby One',Figtree,sans-serif;--font-sans:Figtree,ui-sans-serif,system-ui,sans-serif}.ds-row{display:flex;gap:12px;flex-wrap:wrap;align-items:center;padding:8px}.ds-stamp{display:inline-flex;align-items:center;gap:.35rem;font-family:var(--font-sign);font-size:.875rem;letter-spacing:.04em;border:2.5px solid currentColor;border-radius:7px;padding:4px 10px 3px;transform:rotate(-3deg)}.ds-under{color:var(--color-kale-ink)}.ds-over{color:var(--color-squash-ink)}.ds-ink{color:var(--color-ink)}.ds-tagged{color:var(--color-ink);background:var(--color-tag);border-color:var(--color-ink)}"
    },
    {
      "name": "Chalkboard Tally",
      "kind": "custom",
      "refersTo": "board",
      "description": "The week at a glance: slate board in a crate frame, numerals in raised cells with edge seam notches.",
      "html": "<section class=\"ds-board\"><p class=\"ds-big\"><span class=\"ds-cell\">$</span><span class=\"ds-cell\">8</span><span class=\"ds-cell\">7</span> <span class=\"ds-of\">of $150</span></p><p class=\"ds-sub\"><span class=\"ds-left\">$63 left</span> · 4 days left</p><p class=\"ds-pills\"><span class=\"ds-pill\">Dinners $62 / $110</span><span class=\"ds-pill ds-pill-over\">Extras $25 / $40</span></p></section>",
      "css": ":root{--color-ground:#fbf8f1;--color-ink:#1d241f;--color-ink-soft:#5b5346;--color-crate:#6b4f2e;--color-slate:#1f2a24;--color-slate-cell:#3a4a41;--color-chalk:#f4f1e8;--color-chalk-dim:#b9c4bc;--color-tag:#ffd23f;--color-tomato:#d33722;--color-tomato-dark:#a82b1b;--color-line:#e9e1d2;--color-kale:#2e8b3e;--color-kale-ink:#1f6b2c;--color-kale-wash:#eef7ea;--color-squash:#f26b1d;--color-squash-ink:#a8430c;--color-squash-wash:#fff1e6;--font-sign:'Bowlby One',Figtree,sans-serif;--font-sans:Figtree,ui-sans-serif,system-ui,sans-serif}.ds-board{background:var(--color-slate);color:var(--color-chalk);border:4px solid var(--color-crate);border-radius:18px;box-shadow:inset 0 0 0 2px var(--color-slate-cell),0 6px 14px -8px rgb(29 36 31/.55);padding:16px 16px 12px;font-family:var(--font-sans);font-variant-numeric:tabular-nums;max-width:22rem}.ds-board p{margin:0}.ds-big{font-family:var(--font-sign);font-size:2rem;line-height:1}.ds-cell{position:relative;display:inline-block;min-width:.62em;text-align:center;background:var(--color-slate-cell);border-radius:5px;padding:.04em .08em 0;margin-right:2px;animation:ds-flip 420ms cubic-bezier(.16,1,.3,1)}.ds-cell::before,.ds-cell::after{content:'';position:absolute;top:calc(50% - 1px);width:3px;height:2px;background:var(--color-slate)}.ds-cell::before{left:0}.ds-cell::after{right:0}.ds-of{font-size:1rem;color:var(--color-chalk-dim)}.ds-sub{margin-top:8px!important;font-size:.875rem;font-weight:700;color:var(--color-chalk-dim)}.ds-left{font-family:var(--font-sign);color:var(--color-chalk)}.ds-pills{margin-top:8px!important;display:flex;gap:8px;flex-wrap:wrap;font-size:.75rem;font-weight:800;color:var(--color-chalk-dim)}.ds-pill{border:1.5px dashed #9fb3a6;border-radius:999px;padding:3px 9px}.ds-pill-over{border-color:var(--color-tag);color:var(--color-tag)}@keyframes ds-flip{0%{transform:rotateX(90deg);opacity:.3}100%{transform:rotateX(0);opacity:1}}@media (prefers-reduced-motion:reduce){.ds-cell{animation:none}}"
