      "description": "Shopping rows divided by dashed rules; paid rows take the kale or squash legend, always with words.",
      "html": "<ul class=\"ds-rows\"><li class=\"ds-r\"><b>Eggs, 12 ct</b><span class=\"ds-tag\">$3.49</span></li><li class=\"ds-r ds-r-under\"><b>Spinach</b><span class=\"ds-say ds-say-u\">Paid $2.50, under the estimate</span></li><li class=\"ds-r ds-r-over\"><b>Chicken thighs</b><span class=\"ds-say ds-say-o\">Paid $9.10, $1.12 over</span></li></ul>",
      "css": ":root{--color-ground:#fbf8f1;--color-ink:#1d241f;--color-ink-soft:#5b5346;--color-crate:#6b4f2e;--color-slate:#1f2a24;--color-slate-cell:#3a4a41;--color-chalk:#f4f1e8;--color-chalk-dim:#b9c4bc;--color-tag:#ffd23f;--color-tomato:#d33722;--color-tomato-dark:#a82b1b;--color-line:#e9e1d2;--color-kale:#2e8b3e;--color-kale-ink:#1f6b2c;--color-kale-wash:#eef7ea;--color-squash:#f26b1d;--color-squash-ink:#a8430c;--color-squash-wash:#fff1e6;--font-sign:'Bowlby One',Figtree,sans-serif;--font-sans:Figtree,ui-sans-serif,system-ui,sans-serif}.ds-rows{list-style:none;margin:0;padding:0 16px;background:#fff;border:2px solid var(--color-line);border-radius:16px;font-family:var(--font-sans);color:var(--color-ink)}.ds-r{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 0}.ds-r+.ds-r{border-top:2px dashed var(--color-line)}.ds-r-under{background:var(--color-kale-wash);border:2px solid var(--color-kale)!important;border-radius:12px;padding:12px;margin:6px -8px}.ds-r-over{background:var(--color-squash-wash);border:2px solid var(--color-squash)!important;border-radius:12px;padding:12px;margin:6px -8px}.ds-say{font-size:.875rem;font-weight:800}.ds-say-u{color:var(--color-kale-ink)}.ds-say-o{color:var(--color-squash-ink)}.ds-tag{display:inline-block;background:var(--color-tag);font-family:var(--font-sign);padding:4px 8px 3px;border-radius:4px;transform:rotate(-3deg);box-shadow:2px 3px 0 var(--color-ink)}"
    },
    {
      "name": "Paid Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Big ink-outlined input for thumbs; tag-yellow halo on focus, tomato caret.",
      "html": "<input class=\"ds-field\" inputmode=\"decimal\" placeholder=\"Paid $\">",
      "css": ":root{--color-ground:#fbf8f1;--color-ink:#1d241f;--color-ink-soft:#5b5346;--color-crate:#6b4f2e;--color-slate:#1f2a24;--color-slate-cell:#3a4a41;--color-chalk:#f4f1e8;--color-chalk-dim:#b9c4bc;--color-tag:#ffd23f;--color-tomato:#d33722;--color-tomato-dark:#a82b1b;--color-line:#e9e1d2;--color-kale:#2e8b3e;--color-kale-ink:#1f6b2c;--color-kale-wash:#eef7ea;--color-squash:#f26b1d;--color-squash-ink:#a8430c;--color-squash-wash:#fff1e6;--font-sign:'Bowlby One',Figtree,sans-serif;--font-sans:Figtree,ui-sans-serif,system-ui,sans-serif}.ds-field{background:#fff;border:2px solid var(--color-ink);border-radius:12px;padding:.65rem .8rem;font-family:var(--font-sans);font-weight:800;font-size:1rem;color:var(--color-ink);caret-color:var(--color-tomato);width:8rem}.ds-field::placeholder{color:#766d5f}.ds-field:focus{outline:none;box-shadow:0 0 0 3px var(--color-tag)}"
    },
    {
      "name": "Alert",
      "kind": "card",
      "refersTo": "alert",
      "description": "Errors: tomato-dark ink, tomato-bordered crate for blocking errors, role=alert. Never squash.",
      "html": "<div class=\"ds-alert\" role=\"alert\">Couldn't reach the crew.<button class=\"ds-retry\">Try again</button></div>",
      "css": ":root{--color-tomato:#d33722;--color-tomato-dark:#a82b1b;--color-ink:#1d241f}.ds-alert{display:flex;align-items:center;gap:12px;background:#fff;border:2px solid var(--color-tomato);border-radius:16px;padding:12px;font-family:Figtree,ui-sans-serif,system-ui,sans-serif;font-weight:700;color:var(--color-tomato-dark)}.ds-retry{margin-left:auto;background:#fff;color:var(--color-ink);font:inherit;font-weight:800;font-size:.875rem;border:2px solid var(--color-ink);border-bottom-width:4px;border-radius:14px;padding:.375rem .75rem;cursor:pointer}.ds-retry:active{transform:translateY(2px)}.ds-retry:focus-visible{outline:3px solid var(--color-tomato);outline-offset:2px}"
    },
    {
      "name": "Crate",
      "kind": "card",
      "refersTo": "crate",
      "description": "The one container: white paper, 2px crate-paper border, 16px corners, no shadow, never nested.",
      "html": "<div class=\"ds-crate\"><p class=\"ds-sign\">Tonight</p><p>Sheet-pan chicken with spinach. Serves 3.</p></div>",
      "css": ":root{--color-ground:#fbf8f1;--color-ink:#1d241f;--color-ink-soft:#5b5346;--color-crate:#6b4f2e;--color-slate:#1f2a24;--color-slate-cell:#3a4a41;--color-chalk:#f4f1e8;--color-chalk-dim:#b9c4bc;--color-tag:#ffd23f;--color-tomato:#d33722;--color-tomato-dark:#a82b1b;--color-line:#e9e1d2;--color-kale:#2e8b3e;--color-kale-ink:#1f6b2c;--color-kale-wash:#eef7ea;--color-squash:#f26b1d;--color-squash-ink:#a8430c;--color-squash-wash:#fff1e6;--font-sign:'Bowlby One',Figtree,sans-serif;--font-sans:Figtree,ui-sans-serif,system-ui,sans-serif}.ds-crate{background:#fff;border:2px solid var(--color-line);border-radius:16px;padding:16px;font-family:var(--font-sans);font-weight:700;color:var(--color-ink);transition:border-color 120ms}.ds-crate:hover{border-color:var(--color-ink)}.ds-crate p{margin:0}.ds-sign{font-family:var(--font-sign);font-weight:400;font-size:1.25rem;margin-bottom:6px!important}"
    },
    {
      "name": "Top Nav",
      "kind": "nav",
      "refersTo": "nav-link-active",
      "description": "Sticky stall header: tomato Mise sign, icon-over-label links, active link is an ink pill.",
      "html": "<header class=\"ds-nav\"><span class=\"ds-mark\">Mise</span><nav><a class=\"ds-l ds-on\" aria-current=\"page\" href=\"#\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\"/></svg>Plan</a><a class=\"ds-l\" href=\"#\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m3 17 2 2 4-4\"/><path d=\"m3 7 2 2 4-4\"/><path d=\"M13 6h8\"/><path d=\"M13 12h8\"/><path d=\"M13 18h8\"/></svg>List</a></nav></header>",
      "css": ":root{--color-ground:#fbf8f1;--color-ink:#1d241f;--color-ink-soft:#5b5346;--color-crate:#6b4f2e;--color-slate:#1f2a24;--color-slate-cell:#3a4a41;--color-chalk:#f4f1e8;--color-chalk-dim:#b9c4bc;--color-tag:#ffd23f;--color-tomato:#d33722;--color-tomato-dark:#a82b1b;--color-line:#e9e1d2;--color-kale:#2e8b3e;--color-kale-ink:#1f6b2c;--color-kale-wash:#eef7ea;--color-squash:#f26b1d;--color-squash-ink:#a8430c;--color-squash-wash:#fff1e6;--font-sign:'Bowlby One',Figtree,sans-serif;--font-sans:Figtree,ui-sans-serif,system-ui,sans-serif}.ds-nav{display:flex;align-items:center;gap:8px;padding:8px 12px;background:rgb(251 248 241/.95);border-bottom:2px solid var(--color-line);font-family:var(--font-sans)}.ds-mark{font-family:var(--font-sign);font-size:1.5rem;color:var(--color-tomato);margin-right:auto}.ds-nav nav{display:flex;gap:2px}.ds-l{display:flex;flex-direction:column;align-items:center;gap:2px;padding:4px 8px;border-radius:12px;font-size:11px;font-weight:800;color:var(--color-ink-soft);text-decoration:none}.ds-l:hover{background:var(--color-line)}.ds-l:focus-visible{outline:3px solid var(--color-tomato);outline-offset:2px;}.ds-on{background:var(--color-ink);color:var(--color-chalk)}.ds-on:hover{background:var(--color-ink)}"
    },
    {
      "name": "Awning Edge",
      "kind": "decoration",
      "refersTo": "awning",
      "description": "Landing only: striped tomato/chalk canvas with a scalloped bottom; tops the page, each stall, and the foot.",
      "html": "<div class=\"ds-awning\" aria-hidden=\"true\"></div>",
      "css": ":root{--color-ground:#fbf8f1;--color-ink:#1d241f;--color-ink-soft:#5b5346;--color-crate:#6b4f2e;--color-slate:#1f2a24;--color-slate-cell:#3a4a41;--color-chalk:#f4f1e8;--color-chalk-dim:#b9c4bc;--color-tag:#ffd23f;--color-tomato:#d33722;--color-tomato-dark:#a82b1b;--color-line:#e9e1d2;--color-kale:#2e8b3e;--color-kale-ink:#1f6b2c;--color-kale-wash:#eef7ea;--color-squash:#f26b1d;--color-squash-ink:#a8430c;--color-squash-wash:#fff1e6;--font-sign:'Bowlby One',Figtree,sans-serif;--font-sans:Figtree,ui-sans-serif,system-ui,sans-serif}.ds-awning{height:1.25rem;background:repeating-linear-gradient(90deg,var(--color-tomato) 0 2.25rem,var(--color-chalk) 2.25rem 4.5rem);-webkit-mask:radial-gradient(circle at 50% 100%,transparent .55rem,#000 .6rem) bottom/2.25rem 100% repeat-x;mask:radial-gradient(circle at 50% 100%,transparent .55rem,#000 .6rem) bottom/2.25rem 100% repeat-x}"
    },
    {
      "name": "Stall Sign",
      "kind": "heading",
      "refersTo": "stall-sign",
      "description": "Landing only: crate-wood plate with chalk Bowlby lettering, hung at -1.5deg on two strings from the awning.",
      "html": "<div style=\"padding:4px 16px 16px;background:#fbf8f1\"><h2 class=\"ds-stall-sign\">See the week</h2></div>",
      "css": ":root{--color-ground:#fbf8f1;--color-ink:#1d241f;--color-ink-soft:#5b5346;--color-crate:#6b4f2e;--color-slate:#1f2a24;--color-slate-cell:#3a4a41;--color-chalk:#f4f1e8;--color-chalk-dim:#b9c4bc;--color-tag:#ffd23f;--color-tomato:#d33722;--color-tomato-dark:#a82b1b;--color-line:#e9e1d2;--color-kale:#2e8b3e;--color-kale-ink:#1f6b2c;--color-kale-wash:#eef7ea;--color-squash:#f26b1d;--color-squash-ink:#a8430c;--color-squash-wash:#fff1e6;--font-sign:'Bowlby One',Figtree,sans-serif;--font-sans:Figtree,ui-sans-serif,system-ui,sans-serif}.ds-stall-sign{position:relative;display:inline-block;margin:1.1rem 0 0;background:var(--color-crate);color:var(--color-chalk);font-family:var(--font-sign);font-weight:400;font-size:1.5rem;letter-spacing:.01em;padding:.45rem 1rem .35rem;border-radius:7px;transform:rotate(-1.5deg);box-shadow:0 8px 14px -10px rgb(29 36 31/.6)}.ds-stall-sign::before,.ds-stall-sign::after{content:'';position:absolute;top:-1.1rem;width:2px;height:1.1rem;background:var(--color-ink-soft)}.ds-stall-sign::before{left:1.2rem}.ds-stall-sign::after{right:1.2rem}"
    }
  ],
  "narrative": {
    "northStar": "The Market Stall",
    "overview": "Mise is a farmers-market stall you carry in your pocket. The week's tally is a slate chalkboard in a crate-wood frame, its numerals in raised cells that flip when a price changes. Every estimate price is a tilted yellow shelf tag with a hard printed edge; verdicts arrive as rubber stamps. Everything else stands on an off-white produce-bin ground, separated by dashed crate-paper rules rather than boxed into cards.\n\nThe system is phone-first: one 36rem column, chunky Bowlby signs, bold Figtree reading text, big tap targets. Loudness is reserved for the money: board, tags, stamps and one tomato press button per view.",
    "keyCharacteristics": [
      "Slate chalkboard tally with raised flip cells and edge seam notches",
      "Tilted yellow shelf tags with a hard ink edge",
      "Tomato press buttons on a darker bottom lip",
      "Stamps for verdicts; kale/squash only for under/over, always with words",
      "Bowlby signs on the ground; ruled sections, not nested cards"
    ],
    "rules": [
      {
        "name": "The Strict Legend Rule",
        "body": "Kale means under, squash means over; nothing else uses them and neither appears without words.",
        "section": "colors"
      },
      {
        "name": "The Ink-and-Tag Rule",
        "body": "Non-budget statuses use ink or tag yellow, never kale or squash; errors use tomato-dark ink with a tomato border.",
        "section": "colors"
      },
      {
        "name": "The Sign-on-the-Ground Rule",
        "body": "Bowlby headings stand on the ground, never inside a card header.",
        "section": "typography"
      },
      {
        "name": "The Bold Aisle Rule",
        "body": "Reading text is 700 or heavier.",
        "section": "typography"
      },
      {
        "name": "The Printed Edge Rule",
        "body": "Hard offset shadows are for shelf tags only; buttons get depth from a bottom lip.",
        "section": "elevation"
      },
      {
        "name": "The Ruled Section Rule",
        "body": "Sections and rows are divided by 2px dashed crate-paper rules, never nested boxes.",
        "section": "layout"
      },
      {
        "name": "The Painted Plate Exception",
        "body": "Landing only: stall headings are Bowlby on a crate-wood stall sign; app screens keep signs on the ground.",
        "section": "typography"
      },
      {
        "name": "The Hung Sign Exception",
        "body": "Landing only: the stall sign tilts -1.5deg; in the app only tags and stamps tilt (-3deg).",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do put every estimate price on a shelf tag and every verdict on a stamp.",
      "Do pair kale or squash with the word that says which.",
      "Do use ink or tagged stamps for non-budget statuses.",
      "Do separate sections and rows with the dashed crate-paper rule.",
      "Do honor prefers-reduced-motion.",
      "Do keep tap targets large for one-handed aisle use."
    ],
    "donts": [
      "Don't use kale or squash for errors, selection, quantities or decoration; errors are tomato, selection is tag yellow.",
      "Don't nest crates inside crates.",
      "Don't put a Bowlby sign inside a card header.",
      "Don't give buttons or crates a drop shadow.",
      "Don't draw the flap seam across the digits.",
      "Don't add charts or soft gradient cards; the board is the dashboard.",
      "Don't carry the landing's awning, stall signs, -1.5deg tilt or device frames into app screens."
    ],
    "knownDepartures": [
      "Recipe view boxes its content sections as separate (non-nested) crates instead of ruled sections."
    ]
  }
}
