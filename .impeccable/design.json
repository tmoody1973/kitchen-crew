  "components": [
    {
      "name": "Press Button",
      "kind": "button",
      "refersTo": "button-press",
      "description": "Primary action: tomato block that sinks onto its darker lip. One per view.",
      "html": "<button class=\"ds-btn-press\">Use this plan</button>",
      "css": ":root{--color-ground:#fbf8f1;--color-ink:#1d241f;--color-ink-soft:#5b5346;--color-crate:#6b4f2e;--color-slate:#1f2a24;--color-slate-cell:#3a4a41;--color-chalk:#f4f1e8;--color-chalk-dim:#b9c4bc;--color-tag:#ffd23f;--color-tomato:#d33722;--color-tomato-dark:#a82b1b;--color-line:#e9e1d2;--color-kale:#2e8b3e;--color-kale-ink:#1f6b2c;--color-kale-wash:#eef7ea;--color-squash:#f26b1d;--color-squash-ink:#a8430c;--color-squash-wash:#fff1e6;--font-sign:'Bowlby One',Figtree,sans-serif;--font-sans:Figtree,ui-sans-serif,system-ui,sans-serif}.ds-btn-press{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;background:var(--color-tomato);color:#fff;font-family:var(--font-sign);font-size:1rem;border:0;border-radius:14px;border-bottom:5px solid var(--color-tomato-dark);padding:.7rem 1.1rem;cursor:pointer;transition:transform 120ms ease-out,filter 120ms ease-out}.ds-btn-press:hover{filter:brightness(1.06)}.ds-btn-press:active{transform:translateY(3px);filter:brightness(.95)}.ds-btn-press:focus-visible{outline:3px solid var(--color-tomato);outline-offset:2px;}"
    },
    {
      "name": "Crate Button",
      "kind": "button",
      "refersTo": "button-crate",
      "description": "Secondary action: white with ink outline and a 4px ink lip.",
      "html": "<button class=\"ds-btn-crate\">Try again</button>",
      "css": ":root{--color-ground:#fbf8f1;--color-ink:#1d241f;--color-ink-soft:#5b5346;--color-crate:#6b4f2e;--color-slate:#1f2a24;--color-slate-cell:#3a4a41;--color-chalk:#f4f1e8;--color-chalk-dim:#b9c4bc;--color-tag:#ffd23f;--color-tomato:#d33722;--color-tomato-dark:#a82b1b;--color-line:#e9e1d2;--color-kale:#2e8b3e;--color-kale-ink:#1f6b2c;--color-kale-wash:#eef7ea;--color-squash:#f26b1d;--color-squash-ink:#a8430c;--color-squash-wash:#fff1e6;--font-sign:'Bowlby One',Figtree,sans-serif;--font-sans:Figtree,ui-sans-serif,system-ui,sans-serif}.ds-btn-crate{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;background:#fff;color:var(--color-ink);font-family:var(--font-sans);font-weight:800;font-size:1rem;border:2px solid var(--color-ink);border-bottom-width:4px;border-radius:14px;padding:.6rem 1rem;cursor:pointer;transition:transform 120ms ease-out}.ds-btn-crate:active{transform:translateY(2px)}.ds-btn-crate:focus-visible{outline:3px solid var(--color-tomato);outline-offset:2px;}"
    },
