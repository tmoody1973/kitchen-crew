      "refersTo": "shelf-tag",
      "description": "Every estimate price: tilted yellow tag with a hard printed ink edge.",
      "html": "<span class=\"ds-tag\">$3.49</span>",
      "css": ":root{--color-ground:#fbf8f1;--color-ink:#1d241f;--color-ink-soft:#5b5346;--color-crate:#6b4f2e;--color-slate:#1f2a24;--color-slate-cell:#3a4a41;--color-chalk:#f4f1e8;--color-chalk-dim:#b9c4bc;--color-tag:#ffd23f;--color-tomato:#d33722;--color-tomato-dark:#a82b1b;--color-line:#e9e1d2;--color-kale:#2e8b3e;--color-kale-ink:#1f6b2c;--color-kale-wash:#eef7ea;--color-squash:#f26b1d;--color-squash-ink:#a8430c;--color-squash-wash:#fff1e6;--font-sign:'Bowlby One',Figtree,sans-serif;--font-sans:Figtree,ui-sans-serif,system-ui,sans-serif}.ds-tag{display:inline-block;background:var(--color-tag);color:var(--color-ink);font-family:var(--font-sign);padding:4px 8px 3px;border-radius:4px;transform:rotate(-3deg);box-shadow:2px 3px 0 var(--color-ink);white-space:nowrap}"
    },
