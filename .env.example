# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Mise's own sign-in page (app/sign-in) instead of Clerk's hosted one
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
ANTHROPIC_API_KEY=
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_ZIP=
# Also set on Convex (not here): npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
YOUTUBE_API_KEY=
# The playlist "Sync my playlist" reads (the list= part of a playlist link)
YOUTUBE_PLAYLIST_ID=
TINYFISH_API_KEY=
INSTACART_API_KEY=
